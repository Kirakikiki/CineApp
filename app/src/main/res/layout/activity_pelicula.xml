<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@color/cine_marron"
    android:fillViewport="true">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp">

            <ImageView
                android:id="@+id/imgPoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="16dp"
                android:scaleType="center"
                app:srcCompat="@drawable/images__1_" />

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:background="@drawable/baseline_circle_24"
                android:contentDescription="Atrás"
                android:padding="8dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/outline_arrow_back_ios_new_24"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/baseline_circle_24"
                android:contentDescription="Favorito"
                android:padding="8dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/outline_favorite_24"
                app:tint="@android:color/white" />
        </FrameLayout>


        <TextView
            android:id="@+id/tvTituloPeli"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/tvTitle"
            android:textColor="@android:color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cpYear"
                style=""
                android:text="2024"/>

            <TextView
                android:id="@+id/cpGenre"
                style=""
                android:layout_marginStart="8dp"
                android:text="Suspenso"/>

            <TextView
                android:id="@+id/cpDuration"
                style=""
                android:layout_marginStart="8dp"
                android:text="112 min"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvDirector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="TextView"
            android:textColor="#B0A0C0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvSinopsis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="TextView"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                android:id="@+id/cdPromedio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/cardview_dark_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvTitlePromedio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Promedio"
                        android:textColor="#B0A0C0"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvPromedio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="4.5"
                        android:textColor="#F5C518"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cdRating"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/cardview_dark_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvTitleRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tu calificación"
                        android:textColor="#B0A0C0"
                        android:textSize="13sp" />

                    <androidx.appcompat.widget.AppCompatRatingBar
                        android:id="@+id/rbCalificacion"
                        style="@style/Widget.AppCompat.RatingBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:numStars="5"
                        android:stepSize="1"
                        android:rating="0"
                        android:progressTint="#F5C518"
                        android:secondaryProgressTint="#F5C518"
                        android:progressBackgroundTint="#6B5A8E" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPendiente"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Pendiente"
                android:textColor="@android:color/white"
                app:cornerRadius="26dp"
                app:icon="@drawable/outline_bookmark_24"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@android:color/white"
                app:strokeColor="#9C8FBF"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVista"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Vista"
                android:textColor="@android:color/white"
                app:cornerRadius="26dp"
                app:icon="@drawable/outline_check_small_24"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@android:color/white"
                app:strokeColor="#9C8FBF"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnReseña"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="16dp"
            android:layout_marginTop="16dp"
            android:text="Escribir reseña"
            android:textColor="#1A0F2E"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#FAD201" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>